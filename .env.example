# Copie para .env e preencha. O .env NUNCA vai para o Git.

# --- Broker MQTT ---
# Evento: HiveMQ Cloud (TLS, porta 8883). Teste rápido: broker.hivemq.com / 1883 / MQTT_TLS=0
MQTT_BROKER=
MQTT_PORTA=
MQTT_USUARIO=
MQTT_SENHA=
MQTT_TLS=

# --- Simulador ---
# Quantos minutos simulados passam a cada minuto real (padrão do projeto: 60 = 1 min real = 1 h simulada)
FATOR_TEMPO=

# --- Detecção ---
# 1 = limites curtos para a demonstração
MODO_DEMO=

# --- Demonstrativo de economia (opcional) ---
# Dias que um vazamento duraria sem o LeakFinder (padrão 15) e tarifa em R$/m³ (padrão 7.0032)
DIAS_SEM_SISTEMA=
TARIFA_RS_M3=

# --- Banco ---
DB_CAMINHO=
